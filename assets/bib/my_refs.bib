@article{pamplonaConstructingMagicSquares2025,
  title        = {Constructing {{Magic Squares}}: An Integer Linear Programming Model and a Fast Approach},
  shorttitle   = {Constructing {{Magic Squares}}},
  author       = {Pamplona, Jo{\~a}o Vitor and Pinheiro, Maria Eduarda and Santos, Luiz-Rafael},
  date         = {2026},
  journaltitle = {Computational and Applied Mathematics},
  shortjournal = {Comput. Appl. Math.},
  volume       = {45},
  number       = {332},
  eprint       = {2504.20017},
  eprinttype   = {arXiv},
  eprintclass  = {math},
  doi          = {10.1007/s40314-026-03731-3},
  url          = {https://link.springer.com/article/10.1007/s40314-026-03731-3#citeas},
  urldate      = {2025-05-20},
  abstract     = {Magic squares are a fascinating mathematical challenge that has intrigued mathematicians for centuries. Given a positive (and possibly large) integer \$n\$, one of the main challenges that still remains is to find, within a reliable computational time, a magic square of order \$n\$, that is, a square matrix of order \$n\$ with unique integers from \$a\_\textbraceleft\textbackslash min\textbraceright\$ to \$a\_\textbraceleft\textbackslash max\textbraceright\$, such that the sum of each row, column, and diagonal equals a constant \$\textbackslash mathcal\textbraceleft C\textbraceright (A)\$. In this work, we first present an Integer Linear Programming (ILP) model for constructing a magic square of order \$n\$, which is formulated as a feasibility problem. Nonetheless, the solution time of this ILP model grows exponentially as the order increases. To overcome this limitation, we also propose a heuristic that constructs magic squares depending on whether \$n\$ is odd, singly even, or doubly even. Our numerical results show that the proposed heuristic can construct magic squares of order up to \$70000\$ in less than \$140\$ seconds, demonstrating its efficiency and scalability.},
  keywords     = {lrs},
  file         = {/Users/lrsantos/Zotero/storage/3JT97NQM/Pamplona et al. - 2025 - Constructing Magic Squares an integer linear programming model and a fast heuristic.pdf;/Users/lrsantos/Zotero/storage/73BXC5D8/2504.html}
}


