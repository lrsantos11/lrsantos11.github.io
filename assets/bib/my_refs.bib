@misc{barrosParallelizingCircumcenteredReflectionMethod2025,
type = {In Progress},
  title         = {Parallelizing the {{Circumcentered-Reflection Method}}},
  author        = {Barros, Pablo and Behling, Roger and Guigues, Vincent and Santos, Luiz-Rafael},
  year          = 2025,
  month         = may,
  number        = {arXiv:2505.17258},
  eprint        = {2505.17258},
  primaryclass  = {math},
  publisher     = {arXiv},
  doi           = {10.48550/arXiv.2505.17258},
  urldate       = {2025-05-26},
  abstract      = {This paper introduces the Parallelized Circumcentered Reflection Method (P-CRM), a circumcentric approach that parallelizes the Circumcentered Reflection Method (CRM) for solving Convex Feasibility Problems in affine settings. Beyond feasibility, P-CRM solves the best approximation problem for any finite collection of affine subspaces; that is, it not only finds a feasible point but directly computes the projection of an initial point onto the intersection. Within a fully self-contained scheme, we also introduce the Framework for the Simultaneous Projection Method (F-SPM) which includes Cimmino's method as a special case. Theoretical results show that both P-CRM and F-SPM achieve linear convergence. Moreover, P-CRM converges at a rate that is at least as fast as, and potentially superior to, the best convergence rate of F-SPM. As a byproduct, this also yields a new and simplified convergence proof for Cimmino's method. Numerical experiments show that P-CRM is competitive compared to CRM and indicate that it offers a scalable and flexible alternative, particularly suited for large-scale problems and modern computing environments.},
  archiveprefix = {arXiv},
  copyright     = {All rights reserved},
  pubstate      = {preprint},
  keywords      = {lrs, pipeline},
  file          = {/Users/lrsantos/Zotero/storage/XB6SK6GF/Barros et al. - 2025 - Parallelizing the Circumcentered-Reflection Method.pdf;/Users/lrsantos/Zotero/storage/QA92LKEL/2505.html}
}

@online{behlingBasisPursuitInconsistent2025,
  title         = {Basis Pursuit by Inconsistent Alternating Projections},
  author        = {Behling, Roger and {Bello-Cruz}, Yunier and Santos, Luiz-Rafael and Silva, Paulo J. S.},
  date          = {2025-08-20},
  eprint        = {2508.15026},
  eprinttype    = {arXiv},
  eprintclass   = {math},
  doi           = {10.48550/arXiv.2508.15026},
  url           = {http://arxiv.org/abs/2508.15026},
  urldate       = {2025-10-08},
  abstract      = {Basis pursuit is the problem of finding a vector with smallest \$\textbackslash ell\_1\$-norm among the solutions of a given linear system of equations. It is a famous convex relaxation of what the literature refers to as sparse affine feasibility problem, in which sparse solutions to underdetermined systems are sought. In addition to enjoying convexity, the basis pursuit can be trivially rewritten as a linear program, and thus standard tools in linear programming apply for solving it. In turn, we tackle the basis pursuit in its very original shape with a scheme that uses alternating projections in its subproblems. These subproblems are designed to be inconsistent in the sense that they relate to two non-intersecting sets. Quite recently, inconsistency coming from infeasibility has been seen to work in favor of alternating projections and correspondent convergence rates. In our work, this feature is now suitably enforced in a new and numerically competitive method for solving the basis pursuit.},
  pubstate      = {preprint},
  keywords      = {lrs, pipeline},
  file          = {/Users/lrsantos/Zotero/storage/3LZPS7VF/Behling et al. - 2025 - Basis pursuit by inconsistent alternating projections.pdf;/Users/lrsantos/Zotero/storage/ZXZWEAIX/2508.html}
}


@online{behlingCircumcenteredDirectMethods2026,
  title         = {On Circumcentered Direct Methods for Monotone Variational Inequality Problems},
  author        = {Behling, Roger and {Bello-Cruz}, Yunier and Iusem, Alfredo and Liu, Di and Santos, Luiz-Rafael},
  date          = {2026-02-08},
  eprint        = {2506.17814},
  eprinttype    = {arXiv},
  eprintclass   = {math},
  doi           = {10.48550/arXiv.2506.17814},
  url           = {http://arxiv.org/abs/2506.17814},
  urldate       = {2026-02-11},
  abstract      = {Circumcentered techniques have been shown to significantly accelerate projection-based methods for convex feasibility problems. Motivated by this success, we propose two direct methods with circumcenter acceleration for solving variational inequality problems involving two classes of operators: paramonotone and monotone. Both schemes rely on approximate projections onto separating halfspaces, thereby avoiding computationally expensive exact projections. We establish convergence results for both methods and conduct numerical experiments, demonstrating that the proposed algorithms outperform classical methods, such as the extragradient algorithm, by orders of magnitude in terms of computational time, particularly when the feasible set is a complex intersection of convex sets.},
  pubstate      = {preprint},
  keywords      = {lrs, pipeline},
  file          = {/Users/lrsantos/Zotero/storage/CU4PFDH8/Behling et al. - 2026 - On circumcentered direct methods for monotone variational inequality problems.pdf;/Users/lrsantos/Zotero/storage/7NK9LSBR/2506.html}
}

@article{behlingFejerMonotonicityOptimization2024,
